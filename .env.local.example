# Copy this file to .env.local for local development
# Copy this file to .env for production deployment

# Database (PostgreSQL)
POSTGRES_USER=spinning_kitty
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=spinning_kitty
POSTGRES_PORT=5432

# Database URL for Prisma (update with your actual credentials)
DATABASE_URL="postgresql://spinning_kitty:your_secure_password_here@localhost:5432/spinning_kitty?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"
REDIS_PORT=6379

# App Configuration
NODE_ENV=development
APP_PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: IP Geolocation API
# Get a free API key from ipapi.co or similar service
# IP_GEOLOCATION_API_KEY=your_api_key_here

# Optional: Analytics
# NEXT_PUBLIC_ANALYTICS_ID=

# Optional: WebSocket URL (if using separate WebSocket server)
# NEXT_PUBLIC_WS_URL=ws://localhost:3001
