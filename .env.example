# Database
DATABASE_URL="postgresql://user:password@localhost:5432/spinkitty?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WS_URL="ws://localhost:3000"

# IP to Country Service (optional)
# Options: ipapi.co, ip-api.com, ipgeolocation.io
IP_GEOLOCATION_API_KEY=""
IP_GEOLOCATION_SERVICE="ipapi.co"

# Analytics (optional)
ENABLE_ANALYTICS="true"

# Rate Limiting
RATE_LIMIT_SPIN_PER_MINUTE="100"
RATE_LIMIT_CHAT_PER_MINUTE="5"
